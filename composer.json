{
    "name": "justinholtweb/craft-queuebert",
    "description": "A live control panel bar that surfaces running and queued jobs across Craft's default queue and any custom queue runners — visible only while there's queue activity.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "queuebert",
        "queue",
        "jobs",
        "control panel",
        "monitor",
        "laravel"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Queuebert\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Queuebert\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-unit": "pest --group=unit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/justinholtweb/craft-queuebert/issues",
        "source": "https://github.com/justinholtweb/craft-queuebert"
    },
    "extra": {
        "name": "Queuebert",
        "handle": "queuebert",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-queuebert",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-queuebert/6.0.0/CHANGELOG.md",
        "class": "JustinHoltWeb\\Queuebert\\Plugin"
    }
}
